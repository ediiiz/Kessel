{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "preview": "vite preview",
    "lint": "svelte-kit sync && oxfmt --check src scripts svelte.config.js vite.config.ts vitest.config.ts vitest.setup.ts && oxlint --deny-warnings src scripts svelte.config.js vite.config.ts vitest.config.ts vitest.setup.ts && fallow dead-code --baseline .fallow-baseline.json",
    "fallow": "fallow",
    "fallow:baseline": "fallow --save-baseline .fallow-baseline.json",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "vite build && node scripts/relativize-index.js",
    "test": "svelte-kit sync && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@kessel/api-types": "workspace:*",
    "@lucide/svelte": "1.29.0",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "shadcn-svelte": "1.7.0",
    "svelte-sonner": "1.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "4.3.3",
    "fallow": "3.14.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}

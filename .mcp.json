{
    "mcpServers": {
        "svelte": {
            "type": "http",
            "url": "https://mcp.svelte.dev/mcp"
        },
        "layerchart-v2-next-documentation": {
            "command": "uvx",
            "args": [
                "--from",
                "mcpdoc",
                "--with",
                "mcp<2",
                "mcpdoc",
                "--urls",
                "layerchart-v2-next:https://www.layerchart.com/llms.txt",
                "--transport",
                "stdio"
            ]
        },
        "chrome-devtools": {
            "command": "bunx",
            "args": [
                "chrome-devtools-mcp@latest",
                "--headless=true",
                "--isolated=true"
            ]
        }
    }
}